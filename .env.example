# Copier ce fichier en .env, puis renseigner les valeurs. Le .env n'est jamais versionnÃ©.

# --- ModÃ¨le : Mistral (https://console.mistral.ai, rubrique API Keys) ---
MISTRAL_API_KEY=
COUVERTURE_MODELE=mistral-medium-2604
