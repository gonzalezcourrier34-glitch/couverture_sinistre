# Copier ce fichier en .env, puis renseigner les valeurs. Le .env n'est jamais versionné.

# --- Modèle : Mistral (https://console.mistral.ai, rubrique API Keys) ---
MISTRAL_API_KEY=
COUVERTURE_MODELE=mistral-small-latest
COUVERTURE_MODELE_CONTRAT=mistral-large-latest

# Relecteur (juge de la grille) : un autre modèle, facultatif
# COUVERTURE_MODELE_RELECTURE=mistral-small-latest
# COUVERTURE_RELECTURE=non

# --- Suivi MLflow (docker compose : http://localhost:5010) ---
# MLFLOW_TRACKING_URI=http://localhost:5010
# MLFLOW_ACTIF=false

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=

# --- Bilan par mail (facultatif) ---
# SMTP_HOTE=smtp.gmail.com
# SMTP_PORT=587
# SMTP_UTILISATEUR=
# SMTP_MOT_DE_PASSE=
# BILAN_DESTINATAIRE=