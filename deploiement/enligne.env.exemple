# Modèle du fichier d'environnement de l'image en ligne. Le copier en deploiement/enligne.env (ignoré par git)
# et le remplir : il contient des secrets.
MISTRAL_API_KEY=
# Le code que le navigateur demandera. Long et tiré au hasard, par exemple :
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
COUVERTURE_CODE_ACCES=
# Nombre d'analyses acceptées par jour (chacune appelle le modèle).
COUVERTURE_LIMITE_JOUR=300
COUVERTURE_MODELE=mistral-medium-2604
COUVERTURE_MODELE_VERIFICATION=mistral-small-2603
