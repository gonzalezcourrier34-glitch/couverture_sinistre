      {
        "id": "vol_base",
        "nom": "Vol",
        "article": "3.1.6.1",
        "texte": "La Compagnie garantit, pour autant qu'une plainte ait été déposée auprès des autorités judiciaires ou de police compétentes : n Le vol ou la tentative de vol du contenu ou des valeurs situés dans le bâtiment désigné. n Les dégâts causés par vandalisme au contenu à l'occasion d'un vol ou d'une tentative de vol.",
        "perimetre": [
          {
            "f": [
              "evenement",
              "vol"
            ]
          },
          {
            "f": [
              "plainte_deposee",
              "oui"
            ]
