              ]
            },
            "portee": "tout",
            "a_demander": true,
            "article": "3.1.6.2.2",
            "texte": "les vols à la tire ou à la sauvette commis à l'extérieur du bâtiment désigné"
          },
          {
            "condition": {
              "f": [
                "occupation_irreguliere",
                "oui"
              ]
            },
            "portee": "tout",
            "a_demander": true,
            "article": "3.1.6.2.3",
            "texte": "les vols dans les locaux à occupation irrégulière"
          },
          {
            "condition": {
              "f": [
                "vol_avec_complicite",
                "oui"
              ]
            },
            "portee": "tout",
            "a_demander": true,
            "article": "3.1.6.2.4",
            "texte": "les vols commis par ou avec la complicité de ou du : n Preneur d'assurance, son conjoint, leurs ascendants ou descendants ainsi que les conjoints de ces personnes ; n l'Assuré ; n toute personne au service de l'Assuré pendant les heures de service et, si ces vols ont été commis en dehors de celles-ci, autrement que par effraction ou avec violence."
          },
          {
            "condition": {
              "f": [
                "bien",
                "vehicule_moteur"
              ]
            },
            "portee": "tout",
            "a_demander": true,
            "article": "3.1.6.2.5",
            "texte": "les vols de véhicules automoteurs – à l'exception des engins de jardinage –, des remorques non enfermées dans le bâtiment désigné, ainsi que le vol de leurs accessoires et de leur contenu"
          },
          {
            "condition": {
              "f": [
                "lieu",
                "jardin"
              ]
            },
            "portee": "tout",
            "a_demander": true,
            "article": "3.1.6.2.6",
            "texte": "les vols des biens se trouvant à l'extérieur, dans les cours, les jardins -à l'exception du mobilier de jardin, de l'outillage motorisé ou non et des plantations situés à l'adresse du risque - dans les couloirs et passages d'accès, ainsi que dans les dépendances isolées ou contiguës avec ou sans communication intérieure avec la construction principale et non munies de serrure à cylindre"
          },
          {
            "condition": {
              "f": [
                "lieu",
                "parties_communes"
              ]
            },
            "portee": "tout",
            "a_demander": true,
            "article": "3.1.6.2.7",
            "texte": "si l'Assuré n'occupe que partiellement le bâtiment désigné, le vol des biens se trouvant dans les parties communes et le contenu des garages, caves et greniers s'ils ne sont pas fermés par une serrure de sûreté"
          },
          {
            "condition": {
              "f": [
                "bien",
                "animal"
              ]
            },
            "portee": "tout",
            "a_demander": true,
            "article": "3.1.6.2.8",
            "texte": "le vol des animaux"
          },
          {
            "condition": {
              "f": [
                "batiment_en_construction",
                "oui"
              ]
            },
            "portee": "tout",
            "a_demander": true,
            "article": "3.1.6.2.9",
            "texte": "les vols commis lorsque le bâtiment désigné est en cours de construction, de transformation ou de rénovation à moins que l'Assuré ne démontre que cette circonstance n'a pas contribué à la survenance ou à l'aggravation des conséquences du sinistre"
          },
          {
            "condition": {
              "f": [
                "proprietaire",
                "hote"
              ]
            },
            "portee": "tout",
            "a_demander": true,
            "article": "3.1.6.2.10",
            "texte": "le vol des biens dont l'Assuré n'est pas propriétaire"
          },
          {
            "condition": {
              "f": [
                "abus_confiance",
                "oui"
              ]
            },
            "portee": "tout",
            "a_demander": true,
            "article": "3.1.6.2.11",
            "texte": "l'abus de confiance"
          }
