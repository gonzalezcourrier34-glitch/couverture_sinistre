                  "f": [
                    "plainte_deposee",
                    "oui"
                  ]
                }
              ]
            },
            "article": "4.2.2.1",
            "texte": "pour autant qu’une plainte ait été déposée auprès des autorités judiciaires ou de police compétentes"
          },
          {
            "condition": {
              "si": [
                {
                  "f": [
                    "lieu",
                    "vehicule"
                  ]
                },
                {
